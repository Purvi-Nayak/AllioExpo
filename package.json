{
  "name": "allioexpo",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "start:fast": "expo start --clear --dev-client",
    "start:safe": "NODE_OPTIONS=\"--loader ./ts-loader.mjs\" expo start",
    "start:local": "EXPO_PUBLIC_ENV=local expo start --clear",
    "start:dev": "EXPO_PUBLIC_ENV=development expo start --clear",
    "start:staging": "EXPO_PUBLIC_ENV=staging expo start --clear",
    "start:prod": "EXPO_PUBLIC_ENV=production expo start --clear",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "android:fast": "expo run:android --device",
    "android:local": "EXPO_PUBLIC_ENV=local expo run:android",
    "android:dev": "EXPO_PUBLIC_ENV=development expo run:android",
    "android:staging": "EXPO_PUBLIC_ENV=staging expo run:android",
    "android:prod": "EXPO_PUBLIC_ENV=production expo run:android",
    "ios": "expo run:ios",
    "ios:local": "EXPO_PUBLIC_ENV=local expo run:ios",
    "ios:dev": "EXPO_PUBLIC_ENV=development expo run:ios",
    "ios:staging": "EXPO_PUBLIC_ENV=staging expo run:ios",
    "ios:prod": "EXPO_PUBLIC_ENV=production expo run:ios",
    "web": "expo start --web",
    "build:local": "eas build --profile local",
    "build:dev": "eas build --profile development",
    "build:staging": "eas build --profile staging",
    "build:prod": "eas build --profile production",
    "clean": "expo r --clear && npx expo install --fix",
    "clean:cache": "expo r --clear && rm -rf node_modules && npm install",
    "lint": "expo lint"
  },
  "dependencies": {
    "@expo/cli": "^0.24.20",
    "@expo/vector-icons": "^14.1.0",
    "@react-native-async-storage/async-storage": "2.1.2",
    "@react-native-firebase/app": "^23.2.0",
    "@react-native-firebase/auth": "^23.2.0",
    "@react-native-firebase/firestore": "^23.2.0",
    "@react-native-google-signin/google-signin": "^15.0.0",
    "@react-navigation/bottom-tabs": "^7.3.10",
    "@react-navigation/elements": "^2.3.8",
    "@react-navigation/native": "^7.1.6",
    "@reduxjs/toolkit": "^2.8.2",
    "axios": "^1.12.0",
    "expo": "~53.0.22",
    "expo-auth-session": "^5.5.2",
    "expo-blur": "~14.1.5",
    "expo-constants": "~17.1.7",
    "expo-crypto": "^13.0.2",
    "expo-dev-client": "~5.2.4",
    "expo-font": "~13.3.2",
    "expo-haptics": "~14.1.4",
    "expo-image": "~2.4.0",
    "expo-linking": "~7.1.7",
    "expo-local-authentication": "~16.0.5",
    "expo-router": "~5.1.5",
    "expo-secure-store": "~14.2.4",
    "expo-splash-screen": "~0.30.10",
    "expo-status-bar": "~2.2.3",
    "expo-symbols": "~0.4.5",
    "expo-system-ui": "~5.0.11",
    "expo-web-browser": "~14.2.0",
    "formik": "^2.4.6",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-native": "0.79.5",
    "react-native-gesture-handler": "~2.24.0",
    "react-native-reanimated": "~3.17.4",
    "react-native-reanimated-carousel": "^4.0.3",
    "react-native-safe-area-context": "5.4.0",
    "react-native-screens": "~4.11.1",
    "react-native-size-matters": "^0.4.2",
    "react-native-toast-message": "^2.3.3",
    "react-native-web": "~0.20.0",
    "react-native-webview": "13.13.5",
    "react-redux": "^9.2.0",
    "redux-persist": "^6.0.0",
    "yup": "^1.7.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/react": "~19.0.10",
    "babel-plugin-module-resolver": "^5.0.2",
    "dotenv": "^17.2.2",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~9.2.0",
    "typescript": "~5.8.3"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "redux-persist"
        ]
      }
    }
  },
  "private": true
}
