# .env*.local
# .env.production
# .env.staging
# .env.development
# # You can include .env.development and .env.local in git for team sharing
# # but exclude any files with real production secrets

# # APK files - Don't commit large build files to git
# *.apk
# build-*.apk
# *.aab

# # typescript
# *.tsbuildinfo

# app-example
# dependencies
node_modules/

# Expo caches/builds
.expo/
dist/
web-build/

# Type defs generated by env tooling (generate in scripts or commit if you prefer)
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision
release.keystore

# Metro
.metro-health-check*

# debug logs
npm-debug.*
yarn-debug.*
yarn-error.*

# OS
.DS_Store
*.pem

# Firebase config files (uncomment to ignore; recommended for public repos)
# android/app/google-services.json
# ios/GoogleService-Info.plist

# Environment files
# Keep real env files out of Git; commit only a template (.env.example)
.env*.local
.env.development
.env.staging
.env.production
!.env.example

# APK/AAB build artifacts
*.apk
build-*.apk
*.aab

# TypeScript
*.tsbuildinfo

# Remove this if you actually need a folder named app-example in Git
app-example